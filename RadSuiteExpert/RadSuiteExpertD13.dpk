package RadSuiteExpertD13;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'RadSuite Expert for Delphi 13'}
{$IMPLICITBUILD OFF}
{$DESIGNONLY}

requires
  rtl,
  designide;

contains
  RadSuite.Expert.Wizard in 'src\RadSuite.Expert.Wizard.pas',
  RadSuite.Expert.AboutBox in 'src\RadSuite.Expert.AboutBox.pas',
  RadSuite.Expert.Register in 'src\RadSuite.Expert.Register.pas';

end.
